# SwarmAI Backend Environment Variables (Railway / Production / Local)

# Server Configuration
PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-frontend.pages.dev

# Database (MongoDB Atlas required for production)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/swarmai
MONGODB_DATABASE=swarmai

# AI / LLM Services (Groq Cloud API)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_GEO_MODEL=llama-3.1-8b-instant
GROQ_GEO_TIMEOUT=10

# Vision Validation Model (Local SigLIP HuggingFace Model)
VISION_MODEL_NAME=google/siglip-base-patch16-224
VISION_CONFIDENCE_MARGIN=0.00

# Cloudinary Integration (Permanent Cloud Image Storage)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Twilio SMS Notifications (Emergency Alerts)
TWILIO_ACCOUNT_SID=AC_your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+1234567890
ADMIN_PHONE_NUMBER=+1234567890

# Admin Authentication Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_admin_password

# OpenRouteService API Key (Optional Routing Fallback)
ORS_API_KEY=your_openrouteservice_api_key
